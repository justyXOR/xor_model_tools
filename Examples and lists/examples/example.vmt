"VertexlitGeneric"
{
  "$basetexture" "models/xor/megaprops/box"
  "$bumpmap" "xmdt/default_normalmap"    // Using a default normal map
  "$surfaceprop" "cardboard"

  "$envmap" "env_cubemap"
  "$envmaptint" "[0.1 0.1 0.1]"
  "$normalmapalphaenvmapmask" "0"
  "$envmapsaturation" 0.04

  "$phong" 1
  "$phongexponenttexture" "xmdt/default_phong"    // Using a default phong map
  "$phongfresnelranges" "[0.05 0.5 1]"
  "$phongboost" 0.5
  
  "$model" 1
}
